rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Administrators have `admin: true` on their users/{uid} profile, set in the Firebase console
    // (Firestore → users → the person's document). Members can't set it on themselves; see the
    // users rules below. The older `admin` custom claim (scripts/set-admin.mjs) still works too.
    function isAdmin() {
      let profile = /databases/$(database)/documents/users/$(request.auth.uid);
      return signedIn()
        && (request.auth.token.admin == true
          || (exists(profile) && get(profile).data.get('admin', false) == true));
    }

    // Daily result dates are "YYYY-MM-DD" in the member's own time zone. Somewhere in the world
    // a date runs from 14 hours before it starts in UTC until 36 hours after; 48 leaves time to
    // finish a challenge started just before midnight.
    function isAroundToday(date) {
      let p = date.split('-');
      let start = timestamp.date(int(p[0]), int(p[1]), int(p[2]));
      return date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.time >= start - duration.value(14, 'h')
        && request.time < start + duration.value(48, 'h');
    }

    // The result's scenario is the one scheduled for that date, or, with nothing scheduled, one
    // from the scenario list (the automatic pick happens in the app).
    function dailyScenarioMatches(date, scenarioId) {
      let scheduled = /databases/$(database)/documents/dailyChallenges/$(date);
      return exists(scheduled)
        ? get(scheduled).data.scenarioId == scenarioId
        : scenarioExists(scenarioId);
    }

    function scenarioExists(id) {
      return id is string && exists(/databases/$(database)/documents/scenarios/$(id));
    }

    // Attempt history (PBI 10, src/data/attempts.ts). Only the newest round is checked in
    // detail: earlier rounds were checked when they were added and can't change afterwards.
    function validAttemptRound(r) {
      return r is map
        && r.keys().hasOnly(['mode', 'optionId', 'text', 'score', 'verdict', 'toneMatch',
          'strengths', 'improvements', 'suggestedRewrite'])
        && r.mode in ['choose', 'write']
        && (r.optionId == null || r.optionId is string)
        && r.text is string && r.text.size() > 0 && r.text.size() <= 2000
        && (r.score == null || (r.score is number && r.score >= 1 && r.score <= 10))
        && (r.verdict == null || (r.verdict is string && r.verdict.size() <= 200))
        && (r.toneMatch == null || r.toneMatch in ['on-target', 'close', 'off'])
        && r.strengths is list && r.strengths.size() <= 3
        && r.improvements is list && r.improvements.size() <= 3
        && r.suggestedRewrite is string && r.suggestedRewrite.size() <= 2000;
    }

    function validAttempt(d) {
      return d.keys().hasOnly(['scenarioId', 'scenarioTitle', 'category', 'source', 'dailyDate',
          'mode', 'roundCount', 'rounds', 'averageScore', 'status', 'startedAt', 'updatedAt',
          'completedAt'])
        && d.scenarioTitle is string && d.scenarioTitle.size() <= 200
        && d.category is string && d.category.size() <= 40
        && d.source in ['practice', 'daily', 'replay']
        && (d.source == 'practice'
          ? d.dailyDate == null
          : (d.dailyDate is string && d.dailyDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')))
        && d.mode in ['choose', 'write', 'mixed']
        && d.roundCount is int && d.roundCount >= 1 && d.roundCount <= 20
        && d.rounds is list && d.rounds.size() >= 1 && d.rounds.size() <= d.roundCount
        && validAttemptRound(d.rounds[d.rounds.size() - 1])
        && (d.averageScore == null
          || (d.averageScore is number && d.averageScore >= 1 && d.averageScore <= 10))
        // complete exactly when every round is there, with the time it was completed
        && d.status == (d.rounds.size() == d.roundCount ? 'completed' : 'in-progress')
        && (d.status == 'completed' ? d.completedAt == request.time : d.completedAt == null)
        && d.updatedAt == request.time;
    }

    // Daily challenge schedule: one scenario per date (src/data/daily.ts), set by administrators on
    // the admin page. Dates with no document use an automatic pick from the scenario list.
    match /dailyChallenges/{date} {
      allow read: if signedIn();

      allow create, update: if isAdmin()
        && date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.keys().hasOnly(['scenarioId', 'updatedAt'])
        && scenarioExists(request.resource.data.scenarioId)
        && request.resource.data.updatedAt == request.time;

      allow delete: if isAdmin();
    }

    // Practice scenarios: readable by anyone; only administrators may change them.
    // scripts/seed-scenarios.mjs uses the Admin SDK, which bypasses rules.
    match /scenarios/{scenarioId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User profiles: the document ID is the Firebase Auth uid.
    // Members can only create their profile without `admin` and only change their displayName,
    // so nobody can make themselves an administrator.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'provider', 'createdAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.provider in ['password', 'google.com']
        && request.resource.data.createdAt == request.time;

      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']);

      // Administrators may give or take away the admin role from other members
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['admin'])
        && request.resource.data.admin is bool;

      allow delete: if false;

      // Official daily-challenge results, one per date. Created once when the member finishes
      // that day's challenge and never changed, so a challenge can't be redone for a better score.
      match /dailyResults/{date} {
        allow read: if request.auth != null && request.auth.uid == uid;

        allow create: if request.auth != null
          && request.auth.uid == uid
          && isAroundToday(date)
          && request.resource.data.keys().hasOnly(['scenarioId', 'rounds', 'averageScore', 'completedAt'])
          && dailyScenarioMatches(date, request.resource.data.scenarioId)
          && request.resource.data.rounds is list
          && request.resource.data.rounds.size() > 0
          && (request.resource.data.averageScore == null
            || (request.resource.data.averageScore is number
              && request.resource.data.averageScore >= 1
              && request.resource.data.averageScore <= 10))
          && request.resource.data.completedAt == request.time;

        allow update, delete: if false;
      }

      // Attempt history (PBI 10): one document per attempt, in any practice mode, saved after
      // each round. A member can only add rounds to their own unfinished attempts; earlier rounds,
      // finished attempts and the scenario they belong to can't be changed, and nothing is deleted.
      match /attempts/{attemptId} {
        allow read: if request.auth != null && request.auth.uid == uid;

        allow create: if request.auth != null
          && request.auth.uid == uid
          && validAttempt(request.resource.data)
          && scenarioExists(request.resource.data.scenarioId)
          && request.resource.data.startedAt == request.time;

        allow update: if request.auth != null
          && request.auth.uid == uid
          && resource.data.status == 'in-progress'
          && validAttempt(request.resource.data)
          && request.resource.data.diff(resource.data).unchangedKeys().hasAll(['scenarioId',
            'scenarioTitle', 'category', 'source', 'dailyDate', 'roundCount', 'startedAt'])
          && request.resource.data.rounds.size() > resource.data.rounds.size()
          && request.resource.data.rounds[0:resource.data.rounds.size()] == resource.data.rounds;

        allow delete: if false;
      }
    }
  }
}