rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Administrators have `admin: true` on their users/{uid} profile, set in the Firebase console
    // (Firestore → users → the person's document). Members can't set it on themselves; see the
    // users rules below. The older `admin` custom claim (scripts/set-admin.mjs) still works too.
    function isAdmin() {
      let profile = /databases/$(database)/documents/users/$(request.auth.uid);
      return signedIn()
        && (request.auth.token.admin == true
          || (exists(profile) && get(profile).data.get('admin', false) == true));
    }

    // Daily result dates are "YYYY-MM-DD" in the member's own time zone. Somewhere in the world
    // a date runs from 14 hours before it starts in UTC until 36 hours after; 48 leaves time to
    // finish a challenge started just before midnight.
    function isAroundToday(date) {
      let p = date.split('-');
      let start = timestamp.date(int(p[0]), int(p[1]), int(p[2]));
      return date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.time >= start - duration.value(14, 'h')
        && request.time < start + duration.value(48, 'h');
    }

    // The result's scenario is the one scheduled for that date, or, with nothing scheduled, one
    // from the scenario list (the automatic pick happens in the app).
    function dailyScenarioMatches(date, scenarioId) {
      let scheduled = /databases/$(database)/documents/dailyChallenges/$(date);
      return exists(scheduled)
        ? get(scheduled).data.scenarioId == scenarioId
        : scenarioExists(scenarioId);
    }

    function scenarioExists(id) {
      return id is string && exists(/databases/$(database)/documents/scenarios/$(id));
    }

    // Daily challenge schedule: one scenario per date (src/data/daily.ts), set by administrators on
    // the admin page. Dates with no document use an automatic pick from the scenario list.
    match /dailyChallenges/{date} {
      allow read: if signedIn();

      allow create, update: if isAdmin()
        && date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.keys().hasOnly(['scenarioId', 'updatedAt'])
        && scenarioExists(request.resource.data.scenarioId)
        && request.resource.data.updatedAt == request.time;

      allow delete: if isAdmin();
    }

    // Practice scenarios: readable by anyone; only administrators may change them.
    // scripts/seed-scenarios.mjs uses the Admin SDK, which bypasses rules.
    match /scenarios/{scenarioId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User profiles: the document ID is the Firebase Auth uid.
    // Members can only create their profile without `admin` and only change their displayName,
    // so nobody can make themselves an administrator.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'provider', 'createdAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.provider in ['password', 'google.com']
        && request.resource.data.createdAt == request.time;

      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']);

      // Administrators may give or take away the admin role from other members
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['admin'])
        && request.resource.data.admin is bool;

      allow delete: if false;

      // Official daily-challenge results, one per date. Created once when the member finishes
      // that day's challenge and never changed, so a challenge can't be redone for a better score.
      match /dailyResults/{date} {
        allow read: if request.auth != null && request.auth.uid == uid;

        allow create: if request.auth != null
          && request.auth.uid == uid
          && isAroundToday(date)
          && request.resource.data.keys().hasOnly(['scenarioId', 'rounds', 'averageScore', 'completedAt'])
          && dailyScenarioMatches(date, request.resource.data.scenarioId)
          && request.resource.data.rounds is list
          && request.resource.data.rounds.size() > 0
          && (request.resource.data.averageScore == null
            || (request.resource.data.averageScore is number
              && request.resource.data.averageScore >= 1
              && request.resource.data.averageScore <= 10))
          && request.resource.data.completedAt == request.time;

        allow update, delete: if false;
      }
    }
  }
}