# Copy this file to .env.local and fill in the values from
# Firebase console -> Project settings -> General -> Your apps -> Web app config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: NaviGator model to use (see https://docs.ai.it.ufl.edu/docs/navigator_models).
# Default gpt-oss-120b. Personal keys only cover models hosted locally at UF.
# Your NaviGator API key (https://api.ai.it.ufl.edu/ui). Keep it WITHOUT a VITE_ prefix:
# only the dev server reads it, so it never reaches the browser. An OS environment
# variable with the same name takes priority.
NAVIGATOR_API_KEY=
VITE_NAVIGATOR_MODEL=
