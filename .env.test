# Used by `vite --mode test` for the end-to-end tests (npm run test:e2e).
# Points the app at the local Firebase emulators, so these placeholder values are not secrets.
# Overrides .env.local, so tests never touch the real Firebase project.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-textraordinary.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-textraordinary
VITE_FIREBASE_STORAGE_BUCKET=demo-textraordinary.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
VITE_USE_EMULATORS=true
